# Dreadnought Private Server — Environment Configuration
# Copy this file to .env and fill in your values.
# Usage with docker-compose: cp .env.example .env && docker-compose --env-file ../.env up

# ============================================================
# REQUIRED — change these before deploying!
# ============================================================

# Signing secret for JWT tokens (shared by auth-server, legacy-api, mmogbrain)
# Generate with: openssl rand -hex 32
JWT_SECRET=changeme-dreadnought-jwt-secret

# Admin API key (protects /admin/ban, /admin/unban, /admin/queue)
# Generate with: openssl rand -hex 24
ADMIN_KEY=changeme-admin-key

# Internal service-to-service key (legacy-api -> mmogbrain progression sync)
# Generate with: openssl rand -hex 24
INTERNAL_API_KEY=changeme-internal-api-key

# Public IP of your server (returned to game clients as the match server address)
SERVER_IP=127.0.0.1

# ============================================================
# OPTIONAL — sensible defaults provided
# ============================================================

# Players required before a match starts
# Use 2 for quick local testing, 10 for production Dreadnought matches
PLAYERS_PER_MATCH=10

# Path to DreadGame-Win64-Shipping.exe (on the game-manager host)
GAME_BINARY=/src/Dreadnought/DreadGame/DreadGame/Binaries/Win64/DreadGame-Win64-Shipping.exe

# Wine executable (or 'none' for mock mode — skips spawning actual game processes)
# Use 'wine' on Linux with Wine installed, or 'none' for integration testing
WINE_EXE=wine

# Service bind addresses (change only if you run on non-standard ports)
AUTH_ADDR=:8081
LEGACY_ADDR=:8082
MMOG_ADDR=:8083
MASTER_ADDR=:8084
GM_ADDR=:8085
GW_HTTP_ADDR=:80
GW_HTTPS_ADDR=:443

# TLS certificate paths (generated by scripts/gen-certs.sh)
TLS_CERT=certs/server.crt
TLS_KEY=certs/server.key
