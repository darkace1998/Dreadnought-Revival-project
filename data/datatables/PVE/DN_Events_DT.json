    "PVE_S1E2": {
      "m_name": "\u0000YSeasonsDataManager\u0000\u000e\u0000\u0000\u0000PVE_S1E2_Name\u0000\u0012\u0000\u0000\u0000Operational Risks",
      "m_descShort": "\u0000YSeasonsDataManager\u0000\u0014\u0000\u0000\u0000PVE_S1E2_Desc_Short\u0000(\u0000\u0000\u0000Miner Inconvenience - Operational Risks",
      "m_descLong": "\u0000YSeasonsDataManager\u0000\u0013\u0000\u0000\u0000PVE_S1E2_Desc_Long\u0000'\u0001\u0000\u0000The bandits harassing Jupiter Arms' installations turned out to be the Jovian Raiders, ex-PCF Navy captains gone rogue that want Io for themselves. Now that they have a real opponent to size up against they'll be bringing their best ships and captains to the field; be ready for a proper fight!",
