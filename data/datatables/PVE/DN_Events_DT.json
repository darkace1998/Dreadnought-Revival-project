    "PVE_S3E2": {
      "m_name": "\u0000YSeasonsDataManager\u0000\u000e\u0000\u0000\u0000PVE_S3E2_Name\u0000\u000e\u0000\u0000\u0000Rabbit Season",
      "m_descShort": "\u0000YSeasonsDataManager\u0000\u0014\u0000\u0000\u0000PVE_S3E2_Desc_Short\u0000 \u0000\u0000\u0000Battleship Down - Rabbit Season",
      "m_descLong": "\u0000YSeasonsDataManager\u0000\u0013\u0000\u0000\u0000PVE_S3E2_Desc_Long\u0000X\u0001\u0000\u0000While no longer a threat in orbit, many of the raiders reached Callisto's surface. House Oberon's Navy is en route to the moon, where they hope to make a spectacle of vanquishing the raiders in front of the press, but before that they want you to whittle down the remaining cultist forces to a size the corporate navy can handle without worry.",
