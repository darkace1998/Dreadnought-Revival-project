    "PVE_S1E3": {
      "m_name": "\u0000YSeasonsDataManager\u0000\u000e\u0000\u0000\u0000PVE_S1E3_Name\u0000\u0010\u0000\u0000\u0000Asset Write Off",
      "m_descShort": "\u0000YSeasonsDataManager\u0000\u0014\u0000\u0000\u0000PVE_S1E3_Desc_Short\u0000&\u0000\u0000\u0000Miner Inconvenience - Asset Write Off",
      "m_descLong": "\u0000YSeasonsDataManager\u0000\u0013\u0000\u0000\u0000PVE_S1E3_Desc_Long\u0000\u000f\u0001\u0000\u0000Jupiter Arms' evacuation of their installations on Io has hit a hitch, with workers remaining on the moon left stranded. As the Jovian Raiders prepare their next attack on Kappa Base, it fall on to you to defend the installation and those trapped in it from the assault.",
