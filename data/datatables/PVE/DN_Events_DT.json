    "PVE_S1E1": {
      "m_name": "\u0000YSeasonsDataManager\u0000\u000e\u0000\u0000\u0000PVE_S1E1_Name\u0000\u0014\u0000\u0000\u0000Incident Management",
      "m_descShort": "\u0000YSeasonsDataManager\u0000\u0014\u0000\u0000\u0000PVE_S1E1_Desc_Short\u0000*\u0000\u0000\u0000Miner Inconvenience - Incident Management",
      "m_descLong": "\u0000YSeasonsDataManager\u0000\u0013\u0000\u0000\u0000PVE_S1E1_Desc_Long\u0000U\u0001\u0000\u0000Jupiter Arms installations on the surface of Io have been under attack for weeks by raiding parties using hit and run tactics to wear down the corp's spread out defenses. The megacorp is now contacting  mercenary captains directly to assist their forces and protect Jupiter Arms assets, hoping to finally put an end to these costly attacks.",
