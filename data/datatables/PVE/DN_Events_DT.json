    "PVE_S3E1": {
      "m_name": "\u0000YSeasonsDataManager\u0000\u000e\u0000\u0000\u0000PVE_S3E1_Name\u0000\f\u0000\u0000\u0000Infestation",
      "m_descShort": "\u0000YSeasonsDataManager\u0000\u0014\u0000\u0000\u0000PVE_S3E2_Desc_Short\u0000\f\u0000\u0000\u0000Infestation",
      "m_descLong": "\u0000YSeasonsDataManager\u0000\u0013\u0000\u0000\u0000PVE_S3E1_Desc_Long\u0000X\u0001\u0000\u0000House Oberon industrial installations and Transhuman tech research centers on the Jovian moon Callisto have been targetted by an unknown raider fleet. With Oberon's own Navy too far away to defend their assets from the next attack and an open contract set up, it's up to the Scumbelt's more adventurous mercenary captains to handle the threat.",
