# Copy to run/secrets.env and fill in. scripts/setup.sh generates one for you
# with fresh random values if it does not exist yet.
#
# run/ is gitignored, so real secrets never land in the repository. Keep it that
# way: do not move this file's filled-in copy anywhere tracked.

# HMAC key for signing JWTs. Every service that validates a token needs the SAME
# value: auth-server issues them, legacy-api and mmogbrain verify them. A
# mismatch shows up as the client authenticating and then being rejected on its
# first API call.
#   openssl rand -hex 32
JWT_SECRET=

# Shared key for admin-cli and for the /admin endpoints.
#   openssl rand -hex 32
ADMIN_KEY=

# Service-to-service key (mmogbrain -> game-manager, game-manager ->
# master-server, legacy-api -> mmogbrain progression sync). Falls back to
# ADMIN_KEY when unset, which is fine for a single-host install.
INTERNAL_API_KEY=

# The address CLIENTS are handed for a battle server, and the IP the TLS
# certificate must cover. Leave unset to auto-detect this host's LAN address.
# Set it explicitly on multi-homed hosts, or when clients reach you through a
# router or VPN.
#SERVER_IP=

# Absolute path to the game executable used as the battle server. This is the
# ordinary CLIENT executable -- no dedicated-server build of Dreadnought exists,
# so the same binary is launched headless. Matchmaking will form matches without
# it, but no battle server will start.
#GAME_BINARY=/path/to/Dreadnought/DreadGame/DreadGame/Binaries/Win64/DreadGame-Win64-Shipping.exe

# Wine executable used to run that binary on Linux. Set to "none" on Windows.
#WINE_EXE=wine

# How many queued players form a match. 1 lets a single tester reach a battle
# server without a second client; raise it for real play.
#PLAYERS_PER_MATCH=1
